    target_names=["<=50K", ">50K"],
    zero_division=0
))

fig, axes = plt.subplots(1, 2, figsize=(12, 5))

ConfusionMatrixDisplay.from_predictions(
    y_test,
    y_pred_lr,
    display_labels=["<=50K", ">50K"],
    ax=axes[0]
)
axes[0].set_title("Logistic Regression")

ConfusionMatrixDisplay.from_predictions(
    y_test,
    y_pred_dt,
    display_labels=["<=50K", ">50K"],
    ax=axes[1]
)
axes[1].set_title("Decision Tree")

plt.tight_layout()
plt.show()

results.set_index("Model").plot(
    kind="bar",
    figsize=(10, 6),
    ylim=(0, 1),
    rot=0
)

plt.title("Logistic Regression vs Decision Tree")
plt.ylabel("Score")
plt.xlabel("Model")
plt.grid(axis="y", linestyle="--", alpha=0.5)
plt.tight_layout()
plt.show()

feature_names = preprocessor.get_feature_names_out()

plt.figure(figsize=(22, 10))

plot_tree(
    tree_model,
    feature_names=feature_names,
    class_names=["<=50K", ">50K"],
    filled=True,
    rounded=True,
    max_depth=3,
    fontsize=8
)

plt.title("Decision Tree Visualization")
plt.show()

importance = pd.Series(
    tree_model.feature_importances_,
    index=feature_names
).sort_values(ascending=False)

print("\nTOP 15 DECISION TREE FEATURE IMPORTANCES")
print("----------------------------------------")
print(importance.head(15).round(4))

importance.head(15).sort_values().plot(
    kind="barh",
    figsize=(10, 6)
)

plt.title("Top 15 Feature Importances")
plt.xlabel("Importance")
plt.tight_layout()
plt.show()

coefficients = pd.Series(
    logistic_model.coef_[0],
    index=feature_names
)

print("\nTOP 10 POSITIVE LOGISTIC REGRESSION COEFFICIENTS")
print("------------------------------------------------")
print(coefficients.sort_values(ascending=False).head(10).round(4))

print("\nTOP 10 NEGATIVE LOGISTIC REGRESSION COEFFICIENTS")
print("------------------------------------------------")
print(coefficients.sort_values().head(10).round(4))

print("\nINTERPRETABILITY COMPARISON")
print("---------------------------")
print("Logistic Regression: Coefficients show the direction and strength")
print("of each encoded feature's association with the predicted income class.")
print("\nDecision Tree: Decision rules and feature importance help explain")
print("how the model divides records into income classes.")

