import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.datasets import fetch_20newsgroups
from sklearn.feature_extraction.text import CountVectorizer

data = fetch_20newsgroups(
    subset='train',
    remove=('headers', 'footers', 'quotes')
)

documents = data.data
print("Number of Documents:", len(documents))

vectorizer = CountVectorizer(
    stop_words='english',
    max_features=5000,
    min_df=5
)

X = vectorizer.fit_transform(documents)
vocabulary = vectorizer.get_feature_names_out()

print("Document-Term Matrix Shape:", X.shape)
print("Vocabulary Size:", len(vocabulary))

word_counts = np.asarray(X.sum(axis=0)).flatten()

theta_mle = word_counts / word_counts.sum()

priors = [0.5, 1, 2, 10]
map_results = {}

for alpha in priors:
    theta = word_counts + alpha - 1
    theta = theta / theta.sum()
    map_results[alpha] = theta

def show_top_words(theta, n=10):
    indices = np.argsort(theta)[::-1][:n]
    for i in indices:
        print(vocabulary[i], ":", round(theta[i], 6))

print("\nTop 10 Words using MLE")
show_top_words(theta_mle)

for alpha in priors:
    print("\nMAP with Alpha =", alpha)
    show_top_words(map_results[alpha])

comparison = pd.DataFrame({
    "Word": vocabulary[:20],
    "MLE": theta_mle[:20]
})

for alpha in priors:
    comparison[f"MAP alpha={alpha}"] = map_results[alpha][:20]

print("\nComparison Table:")
print(comparison.to_string(index=False))

plt.figure(figsize=(12, 6))
plt.plot(theta_mle[:200], label="MLE")

for alpha in priors:
    plt.plot(map_results[alpha][:200], label=f"MAP alpha={alpha}")

plt.title("MLE vs MAP")
plt.xlabel("Word Index")
plt.ylabel("Probability")
plt.legend()
plt.show()

print("\nMean Absolute Difference from MLE")

for alpha in priors:
    difference = np.mean(np.abs(theta_mle - map_results[alpha]))
    print("Alpha =", alpha, "Difference =", difference)

print("\nObservations:")
print("MLE uses observed word frequencies.")
print("MAP incorporates Dirichlet priors.")
print("Alpha = 1 gives the same result as MLE.")
print("Larger alpha values smooth the probabilities.")
print("Smaller alpha values produce a more peaked distribution.")
